# Copy this file to .env and fill in your API keys.
# Never commit .env — it is in .gitignore.

# OpenAI (GPT agents, and tau2's GPT-4.1 grader for natural-language assertions)
OPENAI_API_KEY=sk-...

# Anthropic (Claude agents)
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter (hosted open-weight models, e.g. the user simulator)
OPENROUTER_API_KEY=sk-or-...

# Optional: study-wide user simulator. --user-model / --user-provider override these.
# USER_MODEL=openrouter/deepseek/deepseek-v4-pro
# USER_PROVIDER=streamlake
